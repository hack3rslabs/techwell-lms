# Temp/one-off scripts at root
temp_sidebar.tsx
replace-colors.js
fix_security.py

# Root setup/helper scripts (optional dev tools)
setup-everything.bat
start-local.bat

# Log files (always generated, never track)
*.log
*.log.*
backend-install.log
frontend-install.log
docker-db.log
backend-dev.log
frontend-dev.log
backend-db.log

# Playwright
/test-results/
/playwright-report/
/blob-report/
