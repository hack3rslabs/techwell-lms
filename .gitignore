# Environment variables - NEVER commit these
.env
.env.local
.env.*.local

# Dependencies - auto-installed, don't commit
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Production builds - generated, don't commit
/build
/dist
.next/
out/

# Misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# WhatsApp session - LARGE FILES, never commit
.wwebjs_auth/
.wwebjs_cache/
backend/.wwebjs_auth/
backend/.wwebjs_cache/

# Upload temp files
uploads/temp/*
backend/uploads/temp/*

# Recovery/debug files
.lost_found_blobs/
replace_emails.js

# Backend debug/test scripts (not for production)
backend/check_features.js
backend/fix-pass.js
backend/test_ai_interview.js
backend/test_ai_service.js
backend/test_rbac_api.js

# Root setup/helper scripts
setup-everything.bat
start-local.bat
fix_security.py

# Log files at root
*.log
backend-install.log
frontend-install.log
docker-db.log

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Snyk scan results (may contain secrets)
snyk-code-results.json
**/snyk-code-results.json
